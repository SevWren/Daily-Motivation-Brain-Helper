#!/usr/bin/env bash
# ==============================================================================
# Git Hook: pre-commit
# Enforces zero em dashes in all staged files prior to commit creation.
# ==============================================================================

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Run bash scanner
if [ -f "$HOOK_DIR/check-emdash.sh" ]; then
  bash "$HOOK_DIR/check-emdash.sh" --staged
  exit $?
fi

# Fallback to repo root utility script
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ -f "$REPO_ROOT/utility/Check-EmDash.ps1" ] && command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$REPO_ROOT/utility/Check-EmDash.ps1" -Mode Staged
  exit $?
fi

exit 0
