#!/usr/bin/env bash
# ==============================================================================
# Git Hook: pre-push
# Enforces zero em dashes in files modified in outgoing commits before pushing.
# ==============================================================================

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
z40="0000000000000000000000000000000000000000"

# Read push ref specs from standard input
has_input=0
while read -r local_ref local_oid remote_ref remote_oid; do
  has_input=1
  if [ "$local_oid" = "$z40" ]; then
    # Deleting a remote branch, skip check
    continue
  fi

  if [ "$remote_oid" = "$z40" ]; then
    # New branch being pushed
    range="origin/main..$local_oid"
    if ! git rev-parse --verify origin/main >/dev/null 2>&1; then
      range="$local_oid"
    fi
  else
    range="$remote_oid..$local_oid"
  fi

  if [ -f "$HOOK_DIR/check-emdash.sh" ]; then
    bash "$HOOK_DIR/check-emdash.sh" --range "$range"
  fi
done

# If no ref info piped on stdin (e.g. manual invocation), check outgoing commits against upstream
if [ "$has_input" -eq 0 ]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo 'origin/main')"
  if git rev-parse --verify "$upstream" >/dev/null 2>&1; then
    bash "$HOOK_DIR/check-emdash.sh" --range "$upstream..HEAD"
  else
    bash "$HOOK_DIR/check-emdash.sh" --staged
  fi
fi

exit 0
